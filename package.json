{
  "name": "proma",
  "version": "0.1.0",
  "description": "The next gen ai software with general agents",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "(cd apps/server && PROMA_DEV=1 bun src/index.ts) & (cd apps/web && bunx vite --host 127.0.0.1 --port 5174)",
    "dev:web": "bun run --filter='@proma/web' dev",
    "dev:server": "PROMA_DEV=1 bun run --filter='@proma/server' dev",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test",
    "docker:build": "bash scripts/build-docker.sh",
    "docker:build:prod": "bash scripts/build-docker.sh --prod"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dompurify": "^3.4.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.201",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "prosemirror-transform": "1.12.0",
    "prosemirror-view": "1.42.2",
    "prosemirror-model": "1.25.11"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.82.1": "patches/@earendil-works%2Fpi-ai@0.82.1.patch",
    "@earendil-works/pi-coding-agent@0.82.1": "patches/@earendil-works%2Fpi-coding-agent@0.82.1.patch"
  }
}
