# VCS and IDE
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Dependencies and build artifacts (reinstalled / rebuilt inside the image)
**/node_modules
**/dist
**/build
**/.tsbuildinfo

# Tests and temp files
**/*.test.ts
**/*.spec.ts
**/__tests__
tests
**/.cache
**/.turbo
*.log

# Root-level docs only (keep packages/server-core/default-skills/ skill assets)
README.md
CLAUDE.md
docs

# Environment and local config (sensitive)
.env
.env.*
!.env.example

# Docker description files stay out of the image (keep docker/ for COPY entrypoint / bunfig)
Dockerfile
.dockerignore
docker-compose.yml
