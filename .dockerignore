# VCS and IDE
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Dependencies and build artifacts (reinstalled / rebuilt inside the image)
**/node_modules
**/dist
**/build
**/.tsbuildinfo

# Tests and temp files
**/*.test.ts
**/*.spec.ts
**/__tests__
tests
**/.cache
**/.turbo
*.log

# Root-level docs only (keep packages/server-core/default-skills/ skill assets)
README.md
CLAUDE.md
docs

# Environment and local config (sensitive)
.env
.env.*
!.env.example

# NOTE: the Dockerfile must NOT be listed here. docker-java (used by the
# Jenkins docker-build-step) refuses to build when the explicitly specified
# Dockerfile matches a .dockerignore pattern. Keeping it in the context is
# harmless -- it is a few KB and is never COPYed into the image.
