{
  "name": "@proma/server",
  "version": "0.0.25",
  "description": "Proma Web 服务端（Bun + Hono）—— M1 骨架，承接 electronAPI shim 的 HTTP 调用",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build --compile --outfile dist/proma-server src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proma/shared": "workspace:*",
    "@proma/server-core": "workspace:*",
    "hono": "^4.11.5"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
