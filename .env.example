# Proma 本地 / 参考环境变量（生产部署用 K8s Secret / ConfigMap，见 deploy/）
# 复制为 .env 后填写；docker-compose.yml 会自动加载 .env。

# JWT 签名密钥（生成：openssl rand -hex 32）
PROMA_JWT_SECRET=

# 渠道 API Key 加密主密钥（生成：openssl rand -hex 32）
# ⚠ 一旦设置后不可更换：更换将导致历史加密的 API Key 无法解密，需重配所有渠道
PROMA_SERVER_MASTER_KEY=

# admin 首启密码（留空则容器首次启动随机生成并打印到日志）
PROMA_ADMIN_PASSWORD=

# 时区
TZ=Asia/Shanghai
